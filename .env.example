# P0-2 hosted-LLM API configuration (phase 2, M2 arms).
# Copy to .env (gitignored) or export in your shell. NEVER put the real key
# in this file, in configs, or in logs — the transport reads LLM_API_KEY at
# call time (src/agents/backend/api.py).
#
# Authoritative project model (PM decision 2026-10-31, user-ordered):
# poolside/laguna-xs-2.1 — full-week exit run: fallback_share 0.0, p50 4.2 s.
# z-ai/glm-5.3-flash is REJECTED on this account (hard 429; reasoning starves
# the JSON answer). gpt-4o-mini is only api.py's no-suffix default.

AGENT_BACKEND=api:poolside/laguna-xs-2.1
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_API_KEY=<secret — set in your environment or the OpenBot key store>
# SAEA_LLM_TIMEOUT_S=120
