# Backend Dockerfile - Service-Aware Energy Agents API
# syntax=docker/dockerfile:1
FROM python:3.11-slim

# NOTE: no PIP_NO_CACHE_DIR here - the pip layer below uses a BuildKit cache
# mount; PIP_NO_CACHE_DIR=1 would defeat it and every src/ touch would
# re-download the full dependency set (the 20-min Build Backend Image
# timeout on run 43620475737).
ENV PYTHONUNBUFFERED=1 \
    PYTHONHASHSEED=0 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies. src/ changes on nearly every commit, which
# invalidates this layer - the pip cache mount keeps the downloaded wheels
# across builds so rebuilds install from cache instead of the network.
COPY pyproject.toml README.md ./
COPY src/ ./src/
COPY backend/requirements.txt ./backend/
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -e ".[api]" -r backend/requirements.txt

# Copy application code
COPY backend/ ./backend/
COPY configs/ ./configs/
COPY experiments/ ./experiments/
# tests/ needed in-image: agent-task sandbox pipeline runs pytest
# tests/test_baseline_controllers.py from PROJECT_ROOT (agent.py:563)
COPY tests/ ./tests/
# data/ is gitignored; mounted at runtime via docker-compose

# Create non-root user
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://localhost:8000/health').status==200 else 1)"

CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000"]